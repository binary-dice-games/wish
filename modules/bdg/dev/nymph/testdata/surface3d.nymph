A 3D surface of z = sin(r) / r, where r is the distance from the centre, with its peak marked.
--
image:
  width: 900
  height: 680
  scale: 2
root:
  type: Plot3D
  title: z = sin(r) / r
  x_label: x
  y_label: y
  z_label: z
  colormap: Viridis
  children:
    - type: Plot3DSurface
      label: surface
      xs: $x
      ys: $y
      zs: $z
      x_count: 21
      y_count: 21
      fill_alpha: 0.9
    - type: Plot3DScatter
      label: peak
      xs: [0]
      ys: [0]
      zs: [1]
      color: "#C0392B"
      marker: Diamond
      marker_size: 6
    - type: Plot3DLine
      label: axis through the peak
      xs: [0, 0]
      ys: [0, 0]
      zs: [-0.25, 1]
      color: "#C0392B"
      line_weight: 2
--
