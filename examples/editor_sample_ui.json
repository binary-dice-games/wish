{
  "type": "Window",
  "title": "Sample Mock",
  "width": 360,
  "height": 260,
  "children": {
    "main": {
      "type": "VerticalLayout",
      "children": {
        "greeting": { "type": "Label", "text": "Hello from the mock UI!" },
        "sep": { "type": "Separator" },
        "name": { "type": "InputText", "label": "Name", "hint": "Type here..." },
        "agree": { "type": "Checkbox", "label": "I agree", "value": false },
        "volume": { "type": "SliderInt", "label": "Volume", "value": 50, "min": 0, "max": 100 },
        "row": {
          "type": "HorizontalLayout",
          "spacing": 8,
          "children": {
            "ok": { "type": "Button", "label": "OK" },
            "cancel": { "type": "Button", "label": "Cancel" }
          }
        }
      }
    }
  }
}
